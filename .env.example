# Copie este arquivo para .env e ajuste os valores.
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# Nunca versione o arquivo .env (ele já está no .gitignore).

# --- Django -------------------------------------------------------------
# 1 = desenvolvimento (mostra erros detalhados). Use 0 em produção.
DJANGO_DEBUG=1
# Obrigatória quando DJANGO_DEBUG=0. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Necessário quando o site é acessado por HTTPS/ngrok, ex.: https://abcd.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=
# Produção atrás de HTTPS:
# DJANGO_SECURE_COOKIES=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Banco de dados -----------------------------------------------------
# Padrão: db.sqlite3 na pasta do projeto. Para PostgreSQL (instale psycopg):
# DATABASE_URL=postgres://usuario:senha@localhost:5432/fastline
DATABASE_URL=

# --- Regras do FastLine -------------------------------------------------
# Minutos que a disponibilidade fica reservada aguardando o pagamento
FASTLINE_RESERVA_MINUTOS=15
# Taxa de serviço somada a cada pedido (R$). 0.00 = sem taxa
FASTLINE_TAXA_SERVICO=0.00
# Limite de unidades do mesmo produto por pedido
FASTLINE_MAX_ITENS_POR_PRODUTO=20

# --- Pagamentos: PagSeguro / PagBank ------------------------------------
# sandbox (testes) ou producao
PAGSEGURO_AMBIENTE=sandbox
# Token da sua conta sandbox (https://portaldev.pagbank.com.br). Deixe vazio
# para rodar sem PagSeguro (modo "pagamento no balcão").
PAGSEGURO_TOKEN=
# URL pública HTTPS do site para o PagSeguro enviar notificações (webhook) e
# redirecionar após o checkout de cartão, ex.: https://abcd.ngrok-free.app
PAGSEGURO_URL_PUBLICA=
PAGSEGURO_TIMEOUT=20
# Sem PAGSEGURO_TOKEN, permite que o funcionário confirme o pagamento no balcão.
PAGAMENTO_BALCAO_HABILITADO=1
